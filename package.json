{
    "name": "tilbakemeldinger",
    "version": "4.10.5",
    "private": true,
    "author": "Nav",
    "license": "MIT",
    "homepage": "/person/kontakt-oss/tilbakemeldinger",
    "type": "module",
    "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
    "scripts": {
        "build": "pnpm run /^build:.*/",
        "build:client": "vite build",
        "build:server": "vite build --ssr",
        "analyze-bundle": "cross-env ANALYZE=true pnpm run build:client",
        "start": "node --env-file-if-exists=.env dist/server/index.js",
        "start-local": "node -e \"require('fs').copyFileSync('.env.local-prod', '.env')\" && node --env-file-if-exists=.env dist/server/index.js",
        "lint": "pnpm run lint:eslint && pnpm run lint:types",
        "lint:eslint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"common/**/*.{js,jsx,ts,tsx}\" \"server/**/*.{js,jsx,ts,tsx}\" env.schema.ts vite.config.ts",
        "lint:types": "tsc --noEmit",
        "decorator-local": "docker compose up",
        "dev-prepare": "node -e \"require('fs').copyFileSync('.env.development', '.env')\"",
        "dev": "pnpm run dev-prepare && vite",
        "prepare": "husky || true",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@hono/node-server": "2.1.1",
        "@nais/apm": "0.4.0",
        "@navikt/aksel-icons": "8.11.0",
        "@navikt/ds-css": "8.11.0",
        "@navikt/ds-react": "8.11.0",
        "@navikt/fnrvalidator": "1.3.3",
        "@navikt/nav-dekoratoren-moduler": "4.2.2",
        "csp-header": "6.3.1",
        "date-fns": "4.4.0",
        "downshift": "9.3.3",
        "hono": "4.13.2",
        "jose": "6.2.3",
        "openid-client": "6.8.4",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-helmet-async": "3.0.0",
        "react-hook-form": "7.76.1",
        "react-intl": "10.1.8",
        "react-router": "7.18.2",
        "react-router-dom": "7.18.2",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "5.11.2",
        "@eslint/eslintrc": "3.3.5",
        "@eslint/js": "10.0.1",
        "@hono/vite-dev-server": "0.26.1",
        "@types/fetch-mock": "7.3.8",
        "@types/node": "25.9.1",
        "@types/react": "19.2.15",
        "@types/react-dom": "19.2.4",
        "@typescript-eslint/eslint-plugin": "8.60.0",
        "@typescript-eslint/parser": "8.60.0",
        "@vitejs/plugin-react": "6.0.5",
        "cross-env": "10.1.0",
        "eslint": "10.8.0",
        "fetch-mock": "11.1.5",
        "globals": "17.6.0",
        "husky": "9.1.7",
        "lint-staged": "17.0.7",
        "prettier": "3.8.3",
        "rollup-plugin-visualizer": "7.0.1",
        "sass": "1.100.0",
        "typescript": "6.0.3",
        "vite": "8.2.0",
        "vitest": "4.1.10"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,css,scss,md}": "prettier --write",
        "*.{js,jsx,ts,tsx}": "eslint --fix"
    }
}
