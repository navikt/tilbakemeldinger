{
	"name": "tilbakemeldinger",
	"version": "4.10.5",
	"private": true,
	"homepage": "/person/kontakt-oss/tilbakemeldinger",
	"license": "MIT",
	"author": "Nav",
	"type": "module",
	"imports": {
		"#client/*": "./client/*",
		"#dist/*": "./dist/*",
		"#server/*": "./server/*",
		"#shared/*": "./shared/*",
		"#test/*": "./test/*"
	},
	"scripts": {
		"build": "pnpm run build:client && pnpm run build:ssr",
		"build:client": "vite build",
		"build:ssr": "vite build --ssr",
		"build:local": "cross-env NODE_ENV=production CDN_BASE=https://cdn.nav.test/tilbakemeldinger pnpm run build",
		"lint": "oxfmt --check && oxlint && tsc --noEmit && tsc --noEmit -p server",
		"format": "oxfmt",
		"dev": "vite",
		"test": "vitest run",
		"test:dist": "node --test test/dist-smoke.ts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"hooks:fix": "lefthook install --reset-hooks-path"
	},
	"dependencies": {
		"@hono/node-server": "2.1.6",
		"@itsy/corgi": "1.4.1",
		"@itsy/html": "1.2.0",
		"@nais/apm": "0.7.3",
		"@navikt/aksel-icons": "8.22.1",
		"@navikt/client-ip": "^1.0.1",
		"@navikt/ds-css": "8.23.1",
		"@navikt/ds-react": "8.23.1",
		"@navikt/fnrvalidator": "2.2.1",
		"@navikt/nav-dekoratoren-moduler": "4.6.1",
		"@navikt/navno-logger": "1.2.1",
		"@prometheus-io/client": "0.16.1",
		"csp-header": "6.4.0",
		"hono": "4.13.20",
		"hono-rate-limiter": "0.5.4",
		"ip-address": "10.7.6",
		"jose": "6.2.18",
		"lru-cache": "11.5.3",
		"openid-client": "6.9.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hook-form": "7.92.0",
		"react-intl": "12.2.0",
		"ufo": "^1.6.4",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@hono/vite-dev-server": "0.26.1",
		"@navikt/browserslist-config-public": "^1.0.1",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.13",
		"@types/jsdom": "30.0.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"@vitest/coverage-v8": "5.1.1",
		"cross-env": "10.1.0",
		"jsdom": "31.0.1",
		"lefthook": "2.2.2",
		"oxfmt": "^0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2008",
		"pino-pretty": "13.2.0",
		"sass": "1.108.2",
		"typescript": "7.0.2",
		"undici": "8.13.1",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.1",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26"
	},
	"packageManager": "pnpm@12.22.0"
}
