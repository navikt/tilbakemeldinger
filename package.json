{
	"name": "tilbakemeldinger",
	"version": "4.10.5",
	"private": true,
	"homepage": "/person/kontakt-oss/tilbakemeldinger",
	"license": "MIT",
	"author": "Nav",
	"type": "module",
	"imports": {
		"#client/*": "./client/*",
		"#dist/*": "./dist/*",
		"#server/*": "./server/*",
		"#shared/*": "./shared/*",
		"#test/*": "./test/*"
	},
	"scripts": {
		"build": "pnpm run build:client && pnpm run build:ssr",
		"build:client": "vite build",
		"build:ssr": "vite build --ssr client/main-server.tsx",
		"build:local": "cross-env NODE_ENV=production ENV=dev VITE_APP_BASEPATH=/person/kontakt-oss VITE_APP_ORIGIN=https://www.nav.test VITE_TELEMETRY_URL=https://telemetry.test/collect CDN_BASE=https://cdn.nav.test/tilbakemeldinger pnpm run build",
		"analyze-bundle": "cross-env ANALYZE=true pnpm run build:local",
		"lint": "oxfmt --check && oxlint && tsc --noEmit && tsc --noEmit -p server",
		"format": "oxfmt",
		"dev": "vite",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"hooks:fix": "lefthook install --reset-hooks-path"
	},
	"dependencies": {
		"@hono/node-server": "2.1.3",
		"@itsy/html": "1.2.0",
		"@nais/apm": "0.4.0",
		"@navikt/aksel-icons": "8.22.1",
		"@navikt/ds-css": "8.22.1",
		"@navikt/ds-react": "8.22.1",
		"@navikt/fnrvalidator": "1.3.3",
		"@navikt/nav-dekoratoren-moduler": "4.5.0",
		"@prometheus-io/client": "0.16.1",
		"csp-header": "6.3.1",
		"downshift": "9.3.3",
		"hono": "4.13.13",
		"hono-rate-limiter": "0.5.4",
		"ip-address": "10.7.0",
		"jose": "6.2.3",
		"jwt-decode": "4.0.0",
		"lru-cache": "11.5.0",
		"node-cache": "5.1.2",
		"openid-client": "6.8.4",
		"proxy-addr": "2.0.8",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hook-form": "7.76.1",
		"react-intl": "10.1.8",
		"ufo": "^1.6.4",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@hono/vite-dev-server": "0.26.1",
		"@navikt/browserslist-config": "^0.1.0",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/jsdom": "30.0.0",
		"@types/node": "26.6.5",
		"@types/proxy-addr": "2.0.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"@vitest/coverage-v8": "5.0.1",
		"cross-env": "10.1.0",
		"jsdom": "30.1.1",
		"lefthook": "2.2.2",
		"oxfmt": "^0.65.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"rollup-plugin-visualizer": "7.0.1",
		"sass": "1.100.0",
		"typescript": "6.0.3",
		"undici": "8.11.2",
		"vite": "8.2.0",
		"vitest": "5.0.1"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26"
	},
